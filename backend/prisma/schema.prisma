datasource db {
  
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("STUDENT") 
  status       String   @default("ACTIVE")  
  avatar       String?
  phone        String?
  permissions  String   @default("")        
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  activeSessionId String?

  studentProfile Student?
  teacherProfile Teacher?
  noticesAuthored Notice[]
  auditLogs       AuditLog[]
}

model Department {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  hodName       String?
  courses       Course[]
  subjects      Subject[]
  teachers      Teacher[]
  students      Student[]
  classSections ClassSection[]
}

model Course {
  id            String     @id @default(cuid())
  name          String
  code          String     @unique
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  durationYears Int        @default(4)
}

model ClassSection {
  id                 String                     @id @default(cuid())
  name               String                     
  departmentId       String
  department         Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semester           Int                        @default(1)
  academicYear       String                     
  students           Student[]
  timetableSlots     TimetableSlot[]
  attendanceRecords  Attendance[]
  assignments        Assignment[]
  teacherAssignments TeacherSubjectAssignment[]
}

model Subject {
  id                 String                     @id @default(cuid())
  name               String                     
  code               String                     @unique 
  credits            Int                        @default(4)
  semester           Int                        @default(1)
    courseType         String                     @default("THEORY") 
  departmentId       String
  department         Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherSubjectAssignment[]
  timetableSlots     TimetableSlot[]
  notes              Note[]
  assignments        Assignment[]
  attendanceRecords  Attendance[]
  examResults        ExamResult[]
}

model Teacher {
  id                 String                     @id @default(cuid())
  userId             String                     @unique
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId         String                     @unique
  departmentId       String
  department         Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation        String                     
  qualification      String                     
  cabinNo            String?
  subjectAssignments TeacherSubjectAssignment[]
  timetableSlots     TimetableSlot[]
  notes              Note[]
  assignments        Assignment[]
  attendanceMarked   Attendance[]
}

model TeacherSubjectAssignment {
  id             String       @id @default(cuid())
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classSectionId])
}

model Student {
  id                 String                     @id @default(cuid())
  userId             String                     @unique
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNo             String                     @unique 
  admissionNo        String                     @unique 
  departmentId       String
  department         Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  classSectionId     String
  classSection       ClassSection               @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  semester           Int                        @default(1)
  fatherName         String
  motherName         String
  dob                String                     
  bloodGroup         String?
  address            String?
  emergencyContact   String?
  attendance         Attendance[]
  submissions        AssignmentSubmission[]
  examResults        ExamResult[]
  correctionRequests ProfileCorrectionRequest[]
  odRequests         ODRequest[]
  feeInvoices        FeeInvoice[]
}

model Attendance {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  date           String       
  status         String       
  remarks        String?
  createdAt      DateTime     @default(now())

  @@unique([studentId, subjectId, date])
}

model Note {
  id          String   @id @default(cuid())
  title       String
  unit        String   
  description String?
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  fileUrl     String
  fileName    String
  fileSize    String
  createdAt   DateTime @default(now())
}

model Assignment {
  id             String                 @id @default(cuid())
  title          String
  description    String
  subjectId      String
  subject        Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classSectionId String
  classSection   ClassSection           @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  dueDate        String                 
  maxMarks       Int                    @default(100)
  attachmentUrl  String?
  createdAt      DateTime               @default(now())
  submissions    AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt  DateTime   @default(now())
  fileUrl      String
  fileName     String
  status       String     @default("SUBMITTED") 
  marks        Float?
  feedback     String?

  @@unique([assignmentId, studentId])
}

model Exam {
  id           String       @id @default(cuid())
  name         String       
  examType     String       
  examDate     String       
  slot         String?
  code         String?
  course       String?
  semester     Int          @default(1)
  academicYear String       
  regularBacklog String     @default("REGULAR")
  results      ExamResult[]
}

model PlacementDrive {
  id             String   @id @default(cuid())
  companyName    String
  scheduledDate  String   
  salaryStipend  String
  eligibility    String
  degreeBranch   String
  createdAt      DateTime @default(now())
}

model AcademicHoliday {
  id        String   @id @default(cuid())
  date      String   @unique 
  name      String
  type      String   @default("HOLIDAY") 
  createdAt DateTime @default(now())
}

model ExamResult {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marksObtained Float
  maxMarks      Float    @default(100)
  grade         String   
  remarks       String?

  @@unique([examId, studentId, subjectId])
}

model TimetableSlot {
  id             String       @id @default(cuid())
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek      String       
  startTime      String       
  endTime        String       
  room           String       
}

model Notice {
  id             String   @id @default(cuid())
  title          String
  content        String
  category       String   @default("GENERAL") 
  targetAudience String   @default("ALL")     
  priority       String   @default("NORMAL")  
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model ProfileCorrectionRequest {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fieldName      String    
  oldValue       String    
  requestedValue String    
  reason         String    
  documentUrl    String?
  status         String    @default("PENDING") 
  reviewedById   String?
  reviewedAt     DateTime?
  adminRemarks   String?
  createdAt      DateTime  @default(now())
}

model ODRequest {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         String
  reason       String
  documentUrl  String
  status       String   @default("PENDING") 
  reviewedById String?
  reviewedAt   DateTime?
  adminRemarks String?
  createdAt    DateTime @default(now())

  @@index([studentId, date])
}

model FeeInvoice {
  id            String        @id @default(cuid())
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceNumber String        @unique
  term          String
  description   String
  amount        Int
  dueDate       String
  status        String        @default("PENDING") 
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  payments      FeePayment[]

  @@unique([studentId, term])
}

model FeePayment {
  id            String     @id @default(cuid())
  invoiceId     String
  invoice       FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transactionId String     @unique
  amount        Int
  provider      String     @default("CGC-ONLINE")
  status        String     @default("SUCCESS") 
  paidAt        DateTime   @default(now())
  receiptNumber String     @unique
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userRole   String
  userName   String
  action     String   
  entityType String   
  entityId   String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())
}
